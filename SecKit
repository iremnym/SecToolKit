
- Port Scanning: Identify open ports on a target IP address.
- Banner Grabbing: Attempt to retrieve banners from open services.

## Usage
```bash
python scanner.py -t <target_ip> -p <port_range>
```python
import socket
import argparse
import sys
from datetime import datetime

def scan_port(target, port):
    try:
        sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        sock.settimeout(1)
        result = sock.connect_ex((target, port))
        if result == 0:
            print(f"[+] Port {port} is open")
            try:
                banner = sock.recv(1024).decode('utf-8').strip()
                if banner:
                    print(f"    Banner: {banner}")
            except:
                pass
        sock.close()
    except KeyboardInterrupt:
        print("\nExiting Program !!!!")
        sys.exit()
    except socket.gaierror:
        print("\nHostname Could Not Be Resolved !!!!")
        sys.exit()
    except socket.error:
        print("\nServer not responding !!!!")
        sys.exit()

if __name__ == "__main__":
    parser = argparse.ArgumentParser(description="Simple Port Scanner")
    parser.add_argument("-t", "--target", help="Target IP address", required=True)
    parser.add_argument("-p", "--ports", help="Port range (e.g. 1-100) or single port", default="1-1024")
    args = parser.parse_args()

    target = args.target
    
    if "-" in args.ports:
        start_port, end_port = map(int, args.ports.split("-"))
    else:
        start_port = int(args.ports)
        end_port = start_port

    print("-" * 50)
    print(f"Scanning Target: {target}")
    print(f"Scanning started at: {datetime.now()}")
    print("-" * 50)

    for port in range(start_port, end_port + 1):
        scan_port(target, port)
